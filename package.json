{
    "name": "correlateai",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Pair two real public datasets and get an honest verdict on whether their correlation is real or a coincidence.",
    "author": "Victor Saly <victor@victorsaly.com>",
    "license": "MIT",
    "homepage": "https://correlateai.victorsaly.com",
    "repository": {
        "type": "git",
