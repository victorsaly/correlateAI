        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^9.21.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/vite": "^4.1.13",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
