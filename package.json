        "axios": "^1.12.2",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.2",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "node-fetch": "^3.3.2",
        "papaparse": "^5.5.3",
        "sharp": "^0.34.4",
        "tailwindcss": "^4.1.11",
