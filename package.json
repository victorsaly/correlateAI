    },
    "scripts": {
        "dev": "vite",
        "build": "node scripts/ci-build.mjs",
        "prefetch": "node scripts/prefetch-data.js",
        "collect:real": "node scripts/collect-real-sources.mjs",
        "generate-ai": "node scripts/generate-ai-datasets-enhanced.js",
        "lint": "eslint .",
        "preview": "vite preview",
        "security-audit": "./scripts/security-audit.sh",
